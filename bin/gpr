#!/usr/bin/env bash
# gpr — Goal-driven PRD Ratchet
# Audit-verified iterative agent loop.
#
# Apache 2.0. https://github.com/AdityaVG13/GPR

set -euo pipefail

GPR_HOME="${GPR_HOME:-$(cd "$(dirname "$0")/.." && pwd)}"
export GPR_LIB="$GPR_HOME/lib"
export GPR_TEMPLATES="$GPR_HOME/templates"
export GPR_PROMPTS="$GPR_HOME/prompts"
export PYTHONPATH="$GPR_HOME${PYTHONPATH:+:$PYTHONPATH}"

# shellcheck source=lib/term.sh
source "$GPR_LIB/term.sh"

VERSION="0.2.0"

usage() {
  cat <<USAGE
${C_BOLD}gpr${C_RESET} ${C_GRAY}— Goal-driven PRD Ratchet (v${VERSION})${C_RESET}

  Audit-verified iterative agent loop. Hand it a goal and a Plan;
  it ratchets toward done with evidence at every step.

${C_BOLD}USAGE${C_RESET}
  gpr <command> [options]

${C_BOLD}COMMANDS${C_RESET}
  ${C_CYAN}init${C_RESET}              create .gpr/plans/<slug>/Plan.json + Pinned.md + Spine.md
  ${C_CYAN}run${C_RESET}               drive the loop until done / blocked / budget
  ${C_CYAN}status${C_RESET}            show plan progress, next intent, budget burn
  ${C_CYAN}steer${C_RESET}             write a human interrupt to the plan's Steer.md
  ${C_CYAN}audit${C_RESET}             re-run verifyCmds (no looping)
  ${C_CYAN}lint${C_RESET}              warn about weak verifyCmds, dependency cycles
  ${C_CYAN}doctor${C_RESET}            check installed agents, python, git, jq
  ${C_CYAN}render${C_RESET}            write a self-contained HTML view of the Plan
  ${C_CYAN}config${C_RESET}            list / get / set viewer + run defaults
  ${C_CYAN}get${C_RESET}               print a Plan.json field by dotted path
  ${C_CYAN}plan${C_RESET}              list / use / current / rm / rename plans
  ${C_CYAN}import${C_RESET}            fold an external Plan into .gpr/plans/<slug>/
  ${C_CYAN}agent${C_RESET}             list / show / add / rm agent adapters
  ${C_CYAN}commit-intent${C_RESET}     write a conventional-commits message for an intent
  ${C_CYAN}pr-description${C_RESET}    write a PR description for the whole run
  ${C_CYAN}confidence-audit${C_RESET}  scrutinise the Plan for loopholes; loop until 100% confident
  ${C_CYAN}trace${C_RESET}             tail recent events
  ${C_CYAN}next-intent${C_RESET}       (skill) pick + mark in-progress; print the intent
  ${C_CYAN}render-prompt${C_RESET}     (skill) print the rendered continuation prompt
  ${C_CYAN}ingest-signal${C_RESET}     (skill) parse a signal block, run audit, persist

${C_BOLD}GLOBAL OPTIONS${C_RESET}
  ${C_CYAN}--plan SLUG${C_RESET}       operate on a specific plan (default: \$GPR_PLAN or .gpr/active or "default")

${C_BOLD}EXAMPLES${C_RESET}
  ${C_GRAY}# scaffold and run autonomously${C_RESET}
  gpr init --objective "Build a TODO REST API with auth"
  \$EDITOR .gpr/plans/default/Plan.json
  gpr run --agent claude --max-cost-usd 5

  ${C_GRAY}# multiple plans in parallel${C_RESET}
  gpr init --plan todo-api --objective "TODO REST API"
  gpr init --plan auth --objective "OAuth2 flow"
  gpr run --plan todo-api --agent claude &
  gpr run --plan auth --agent codex &

  ${C_GRAY}# fold an external Plan${C_RESET}
  gpr import ~/Drafts/strategy.json --name strategy --activate

  ${C_GRAY}# any CLI works (auto stdin-passthrough)${C_RESET}
  gpr run --agent grok           ${C_GRAY}# just runs \`grok\` and pipes the prompt${C_RESET}
  gpr run --agent custom --cmd "ollama run llama3"

  ${C_GRAY}# mid-run redirect${C_RESET}
  gpr steer "Switch from sqlite to postgres"

  ${C_GRAY}# inside a Claude TUI session (skill mode)${C_RESET}
  /gpr next        ${C_GRAY}# picks intent + renders prompt${C_RESET}

${C_BOLD}LINKS${C_RESET}
  https://github.com/AdityaVG13/GPR

USAGE
}

cmd_help() { usage; }

cmd_version() { echo "gpr $VERSION"; }

cmd_init() {
  local objective="" project="" branch="" from="" force="" plan=""
  while (( $# > 0 )); do
    case "$1" in
      --objective) objective="$2"; shift 2 ;;
      --project) project="$2"; shift 2 ;;
      --branch) branch="$2"; shift 2 ;;
      --from) from="$2"; shift 2 ;;
      --plan) plan="$2"; shift 2 ;;
      --force) force="--force"; shift ;;
      -h|--help)
        echo "gpr init --objective TEXT [--project NAME] [--branch X] [--from FILE] [--plan SLUG] [--force]"
        return 0 ;;
      *) log_fail "unknown arg: $1"; return 2 ;;
    esac
  done
  if [[ -z "$objective" ]]; then
    log_fail "--objective is required"
    return 2
  fi
  banner "gpr init" "$objective"
  hr
  local args=(--objective "$objective")
  [[ -n "$project" ]] && args+=(--project "$project")
  [[ -n "$branch" ]] && args+=(--branch "$branch")
  [[ -n "$from" ]] && args+=(--from "$from")
  [[ -n "$plan" ]] && args+=(--plan "$plan")
  [[ -n "$force" ]] && args+=("$force")
  local out
  out=$(python3 -m lib.cli init "${args[@]}" --json)
  local slug
  slug=$(echo "$out" | python3 -c "import sys, json; print(json.load(sys.stdin).get('slug','default'))")
  log_ok "wrote .gpr/plans/$slug/Plan.json"
  log_info "next: edit .gpr/plans/$slug/Plan.json to add intents and checks"
  log_info "then: gpr run --plan $slug --agent claude"
}

cmd_run() {
  local agent="claude" max_iters=50 iter_timeout=1800
  local deep_audit="0" audit_agent="" model="" plan=""
  local custom_cmd="" prompt_mode=""
  while (( $# > 0 )); do
    case "$1" in
      --agent) agent="$2"; shift 2 ;;
      --model) model="$2"; shift 2 ;;
      --plan) plan="$2"; shift 2 ;;
      --cmd) custom_cmd="$2"; shift 2 ;;
      --prompt-mode) prompt_mode="$2"; shift 2 ;;
      --max-iters) max_iters="$2"; shift 2 ;;
      --iter-timeout) iter_timeout="$2"; shift 2 ;;
      --max-cost-usd) GPR_BUDGET_MAX_COST_USD="$2"; export GPR_BUDGET_MAX_COST_USD; shift 2 ;;
      --budget) GPR_BUDGET_TOKENS="$2"; export GPR_BUDGET_TOKENS; shift 2 ;;
      --deep-audit) deep_audit="1"; shift ;;
      --audit-agent) audit_agent="$2"; shift 2 ;;
      -h|--help)
        cat <<HELP
gpr run [--agent NAME] [--model ID] [--plan SLUG] [--max-iters N]
        [--iter-timeout SEC] [--max-cost-usd USD] [--deep-audit]
        [--audit-agent X] [--cmd "<binary args>" --prompt-mode stdin|argv_last|argv_named]

  --agent NAME       Any CLI on PATH works. Built-in adapters: claude, codex,
                     opencode, gemini, echo. Anything else gets an auto
                     stdin-passthrough adapter. Custom one-shot adapter:
                     pass --agent custom and provide --cmd / --prompt-mode.
  --plan SLUG        Operate on .gpr/plans/<slug>/ (default: active plan).
  --model ID         Force the agent's underlying model (e.g. claude-opus-4-7,
                     gpt-5-codex, grok-2). Forwarded to CLIs whose adapter
                     declares a model_flag. Otherwise recorded for cost
                     accounting only — pass model selection via the CLI's own
                     config or GPR_AGENT_EXTRA_ARGS.
  --cmd "..."        With --agent custom, the binary + args invoked per iter.
                     E.g.  --cmd "ollama run llama3"  or  --cmd "llm -m gpt-4o".
  --prompt-mode      How the binary expects the prompt:
                       stdin        — piped on stdin (default; most local LLMs)
                       argv_last    — appended as the last positional arg
                       argv_named   — preceded by --prompt-flag (use with the
                                       --prompt-flag value baked into --cmd).

ENV
  GPR_PLAN                Active plan slug (overridden by --plan).
  GPR_MODEL               Force the model (overridden by --model).
  GPR_AGENT_EXTRA_ARGS    Extra flags appended to every agent invocation.
                          Quoted; split with shell rules. Example:
                            GPR_AGENT_EXTRA_ARGS='--allowedTools "Bash(rtk *)"' \\
                              gpr run --agent claude

  GPR_AGENT_CUSTOM_CMD    Same as --cmd for --agent custom.
  GPR_AGENT_CUSTOM_PROMPT_MODE  Same as --prompt-mode.
  GPR_AGENT_CUSTOM_PROMPT_FLAG  Flag for argv_named mode (e.g. --prompt).
HELP
        return 0 ;;
      *) log_fail "unknown arg: $1"; return 2 ;;
    esac
  done
  [[ -n "$model" ]] && { GPR_MODEL="$model"; export GPR_MODEL; }
  [[ -n "$plan" ]] && { GPR_PLAN="$plan"; export GPR_PLAN; }
  [[ -n "$custom_cmd" ]] && { GPR_AGENT_CUSTOM_CMD="$custom_cmd"; export GPR_AGENT_CUSTOM_CMD; }
  [[ -n "$prompt_mode" ]] && { GPR_AGENT_CUSTOM_PROMPT_MODE="$prompt_mode"; export GPR_AGENT_CUSTOM_PROMPT_MODE; }
  export GPR_DEEP_AUDIT="$deep_audit"
  [[ -n "$audit_agent" ]] && export GPR_AUDIT_AGENT="$audit_agent"
  # shellcheck source=lib/agents.sh
  source "$GPR_LIB/agents.sh"
  # No allow-list: agent_supports() always returns 0. agent_run will fail
  # cleanly later if the binary isn't on PATH.
  local resolved_slug="${plan:-${GPR_PLAN:-default}}"
  banner "gpr run" "agent=$agent  plan=$resolved_slug  max-iters=$max_iters"
  hr

  export GPR_AGENT="$agent" GPR_MAX_ITERS="$max_iters" GPR_ITER_TIMEOUT="$iter_timeout"
  # shellcheck source=lib/loop.sh
  source "$GPR_LIB/loop.sh"
  local rc
  set +e
  loop_run
  rc=$?
  set -e
  hr
  case $rc in
    0) log_ok "run complete: achieved" ;;
    2) log_warn "run paused: blocked" ;;
    3) log_warn "run paused: decide" ;;
    4) log_warn "run paused: budget_limited" ;;
    5) log_warn "run paused: unmet_zero_progress / max_iters" ;;
    6) log_warn "run paused: unmet_stalemate" ;;
    7) log_warn "run paused: rescope_pending" ;;
    8) log_fail "run aborted: unmet_disk_full" ;;
    *) log_fail "run aborted (rc=$rc)" ;;
  esac
  return $rc
}

cmd_status() {
  local plan_arg=()
  while (( $# > 0 )); do
    case "$1" in
      --plan) plan_arg=(--plan "$2"); shift 2 ;;
      -h|--help) echo "gpr status [--plan SLUG]"; return 0 ;;
      *) log_fail "unknown arg: $1"; return 2 ;;
    esac
  done
  local json
  json=$(python3 -m lib.cli status --json ${plan_arg[@]+"${plan_arg[@]}"} 2>&1) || { echo "$json" >&2; return 1; }
  local goal project branch status iter
  goal=$(echo "$json" | jq -r .goal)
  project=$(echo "$json" | jq -r .project)
  branch=$(echo "$json" | jq -r .branch)
  status=$(echo "$json" | jq -r .status)
  iter=$(echo "$json" | jq -r .iteration)
  banner "gpr status" "$project  $C_GRAY|$C_RESET  branch $branch"
  hr
  row "goal"      "$goal"   "$C_WHITE"
  row "status"    "$status" "$C_CYAN"
  row "iteration" "$iter"   "$C_WHITE"
  echo
  log_info "intents:"
  echo "$json" | python3 -c "
import sys, json
d = json.load(sys.stdin)
counts = d['intents']
order = ['open','in_progress','done','paused']
for k in order:
  if counts.get(k):
    print(f\"    {k:<14} {counts[k]}\")"
  echo
  log_info "next intent:"
  local next_id next_title
  next_id=$(echo "$json" | jq -r '.next_intent_id // "(none)"')
  next_title=$(echo "$json" | jq -r '.next_intent_title // ""')
  printf "    %s%s%s %s%s%s\n" "$C_BOLD" "$next_id" "$C_RESET" "$C_GRAY" "$next_title" "$C_RESET"
  echo
  log_info "budget:"
  local frac axis cost tin tout wall
  frac=$(echo "$json" | jq -r '.budget.fraction_used')
  axis=$(echo "$json" | jq -r '.budget.binding_axis // "(none)"')
  cost=$(echo "$json" | jq -r '.budget.costUsd')
  tin=$(echo "$json" | jq -r '.budget.tokensInput')
  tout=$(echo "$json" | jq -r '.budget.tokensOutput')
  wall=$(echo "$json" | jq -r '.budget.wallClockSeconds')
  local barstr; barstr=$(bar "$frac" 28)
  printf "    %s  %s  %s%s of binding axis (%s)%s\n" \
    "$barstr" "$(awk -v f="$frac" 'BEGIN{printf "%5.1f%%", f*100}')" "$C_GRAY" "" "$axis" "$C_RESET"
  row "tokens in"   "$(fmt_int "$tin")"  "$C_WHITE"
  row "tokens out"  "$(fmt_int "$tout")" "$C_WHITE"
  row "wall-clock"  "$(fmt_duration "$wall")" "$C_WHITE"
  row "cost"        "$(fmt_usd "$cost")" "$C_GREEN"
}

cmd_steer() {
  local abort="" message="" plan_arg=()
  while (( $# > 0 )); do
    case "$1" in
      --abort) abort="--abort"; shift ;;
      --plan) plan_arg=(--plan "$2"); shift 2 ;;
      -h|--help) echo "gpr steer [--plan SLUG] [--abort] \"<message>\""; return 0 ;;
      *) message="$1"; shift ;;
    esac
  done
  python3 -m lib.cli steer ${plan_arg[@]+"${plan_arg[@]}"} $abort "$message"
}

cmd_audit() {
  local intent="" reverse="" plan_arg=()
  while (( $# > 0 )); do
    case "$1" in
      --intent) intent="--intent $2"; shift 2 ;;
      --reverse) reverse="--reverse"; shift ;;
      --plan) plan_arg=(--plan "$2"); shift 2 ;;
      -h|--help) echo "gpr audit [--plan SLUG] [--intent ID] [--reverse]"; return 0 ;;
      *) log_fail "unknown arg: $1"; return 2 ;;
    esac
  done
  banner "gpr audit" ""
  hr
  # shellcheck disable=SC2086
  python3 -m lib.cli audit ${plan_arg[@]+"${plan_arg[@]}"} $intent $reverse --json
}

cmd_lint() {
  local plan_arg=()
  while (( $# > 0 )); do
    case "$1" in
      --plan) plan_arg=(--plan "$2"); shift 2 ;;
      -h|--help) echo "gpr lint [--plan SLUG]"; return 0 ;;
      *) log_fail "unknown arg: $1"; return 2 ;;
    esac
  done
  banner "gpr lint" ""
  hr
  python3 -m lib.cli lint ${plan_arg[@]+"${plan_arg[@]}"}
}

cmd_doctor() {
  banner "gpr doctor" "v${VERSION}"
  hr
  local json
  json=$(python3 -m lib.cli doctor --json)
  local sys_name sys_release sys_machine py_ver
  sys_name=$(echo "$json" | jq -r '.platform.system')
  sys_release=$(echo "$json" | jq -r '.platform.release')
  sys_machine=$(echo "$json" | jq -r '.platform.machine')
  py_ver=$(echo "$json" | jq -r '.platform.python')
  row "platform" "${sys_name} ${sys_release} (${sys_machine})" "$C_WHITE"
  row "python"   "${py_ver}" "$C_WHITE"
  echo
  echo "$json" | python3 -c "
import sys, json
d = json.load(sys.stdin)
for c in d['checks']:
  glyph = '+' if c['ok'] else 'x'
  path = c.get('path') or '(not found)'
  print(f'  {glyph}  {c[\"name\"]:<10}  {path}')"
  if echo "$json" | grep -q '"ok": true'; then
    echo
    log_ok "doctor: all required deps present"
  else
    echo
    log_warn "doctor: some required deps missing"
    return 1
  fi
}

cmd_trace() {
  local since="100" plan_slug=""
  while (( $# > 0 )); do
    case "$1" in
      --plan) plan_slug="$2"; shift 2 ;;
      -h|--help) echo "gpr trace [--plan SLUG] [N]"; return 0 ;;
      *) since="$1"; shift ;;
    esac
  done
  if [[ -z "$plan_slug" ]]; then
    plan_slug=$(python3 -c "
import sys, os; sys.path.insert(0, '$GPR_HOME')
from lib.state import plan as P
print(os.environ.get('GPR_PLAN') or P.read_active_slug('.') or 'default')")
  fi
  banner "gpr trace" "tail $since events  (plan=$plan_slug)"
  hr
  python3 -c "
import sys, json
sys.path.insert(0, '$GPR_HOME')
from lib.state import events
for e in events.tail('.', $since, slug='$plan_slug'):
  print(json.dumps(e))" 2>/dev/null || log_warn "no events yet"
}

cmd_next_intent()   { python3 -m lib.cli next-intent "$@"; }
cmd_render_prompt() { python3 -m lib.cli render-prompt "$@"; }
cmd_ingest_signal() { python3 -m lib.cli ingest-signal "$@"; }

# Dispatch.
if (( $# == 0 )); then
  usage
  exit 0
fi

cmd="$1"
shift
case "$cmd" in
  init)              cmd_init "$@" ;;
  run)               cmd_run "$@" ;;
  status)            cmd_status "$@" ;;
  steer)             cmd_steer "$@" ;;
  audit)             cmd_audit "$@" ;;
  lint)              cmd_lint "$@" ;;
  doctor)            cmd_doctor "$@" ;;
  render)            python3 -m lib.cli render "$@" ;;
  config)            python3 -m lib.cli config "$@" ;;
  get)               python3 -m lib.cli get "$@" ;;
  plan)              python3 -m lib.cli plan "$@" ;;
  import)            python3 -m lib.cli import "$@" ;;
  agent)             python3 -m lib.cli agent "$@" ;;
  commit-intent)
    # shellcheck source=lib/commit.sh
    source "$GPR_LIB/commit.sh"
    cmd_commit_intent "$@" ;;
  pr-description)
    source "$GPR_LIB/commit.sh"
    cmd_pr_description "$@" ;;
  confidence-audit)
    source "$GPR_LIB/commit.sh"
    cmd_confidence_audit "$@" ;;
  trace)             cmd_trace "$@" ;;
  next-intent)       cmd_next_intent "$@" ;;
  render-prompt)     cmd_render_prompt "$@" ;;
  ingest-signal)     cmd_ingest_signal "$@" ;;
  help|-h|--help)    cmd_help ;;
  version|--version) cmd_version ;;
  *)
    log_fail "unknown command: $cmd"
    echo
    usage
    exit 2
    ;;
esac
